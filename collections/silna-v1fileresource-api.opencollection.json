              }
            ]
          },
          "docs": "Get File"
        },
        {
          "info": {
            "name": "Upload file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.silnahealth.com/api/public/v1/files/",
            "headers": [
              {
                "name": "provider-id",
                "value": "null"
              },
              {
                "name": "original-filename",
